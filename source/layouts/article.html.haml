!!!
%html{ :xmlns => "http://www.w3.org/1999/xhtml", :'xml:lang' => "en", :lang => "en" }
  %head
    %meta{ :'http-equiv' => "Content-type", content: "text/html; charset=utf-8" }
    %link{ rel: 'shortcut icon', :href => '../../../favico.ico' }
    %script{ :type => 'text/javascript', :src => '../../../javascripts/shjs-0.6/sh_main.min.js' }
    %script{ :type => "text/javascript", :src => "http://platform.twitter.com/widgets.js" }
    %link{ :type => 'text/css', :rel => 'stylesheet', :href => '../../../javascripts/shjs-0.6/css/sh_nedit.min.css' }
    %link{ :rel => 'stylesheet', :href => '../../../stylesheets/basic.css', :type => 'text/css' }
    %link{ :rel => 'stylesheet', :href => '../../../stylesheets/blog.css', :type => 'text/css' }
    %title= current_article.title
    :javascript
      var _gaq = _gaq || [];
      _gaq.push(['_setAccount', 'UA-20991642-1']);
      _gaq.push(['_trackPageview']);

      (function() {
        var ga = document.createElement('script'); ga.type = 'text/javascript'; ga.async = true;
        ga.src = ('https:' == document.location.protocol ? 'https://ssl' : 'http://www') + '.google-analytics.com/ga.js';
        var s = document.getElementsByTagName('script')[0]; s.parentNode.insertBefore(ga, s);
      })();
  %body{:onload => 'sh_highlightDocument("../../../javascripts/shjs-0.6/lang/", ".min.js");'}
    %ol.nav
      %li
        %a{ :href => './../../../../' } home
        •
      %li
        %a{ :href => './../../../' } blog
        •
      %li
        %a{ :href => './../../../../picky/' } picky
        •
      %li
        %a{ :href => './../../../../phd/' } phd
        •
      %li
        %a{ :href => './../../../../phony/' } phony
        •
      %li
        %a{ :href => './../../../../view_models/' } view models
    %div.post
      - permalink = 'http://florianhanke.com/blog' + current_article.slug + '.html'
      %h1
        = current_article.title
        %a{ :href => "http://twitter.com/share", :class => "twitter-share-button", :'data-url' => permalink, :'data-text' => current_article.title, :'data-count' => "none", 'data-via' => "hanke", :'data-width' => "55px" } Tweet
      .categories
        = current_article.tags.join(" / ")
      ~ yield
      - if next_article = current_article.article_next
        Next
        %a{ :href => "/blog#{next_article.url}", :title => "Next post: #{next_article.title}" }= next_article.title
      %h2 Share
      %p
        %a{ :href => "http://twitter.com/share", :class => "twitter-share-button", :'data-url' => permalink, :'data-text' => current_article.title, :'data-count' => "none", 'data-via' => "hanke", :'data-width' => "55px" } Tweet
      %br
      - if previous_article = current_article.article_previous
        Previous
        %a.previous{ :href => "../../..#{previous_article.url}", :title => "Previous post: #{previous_article.title}" }= previous_article.title
      %h2 Comments?
      #disqus_thread
      :javascript
        var disqus_shortname = 'florianhanke';
        var disqus_developer = location.host.match(/\.dev$|^localhost/) ? 1 : 0;
        var disqus_identifier = '#{current_article.slug}';
        var disqus_url = '#{permalink}';

        /* * * DON'T EDIT BELOW THIS LINE * * */
        (function() {
            var dsq = document.createElement('script'); dsq.type = 'text/javascript'; dsq.async = true;
            dsq.src = 'http://' + disqus_shortname + '.disqus.com/embed.js';
            (document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(dsq);
        })();
      %noscript
        Please enable JavaScript to view the
        %a{ :href => "http://disqus.com/?ref_noscript" } comments powered by Disqus.
